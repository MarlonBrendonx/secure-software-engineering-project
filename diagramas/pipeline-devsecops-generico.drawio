        <mxCell id="b6" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA7B4;strokeWidth=1.2;fontFamily=Helvetica;" value="" vertex="1">
