# Copie para .env e preencha. Valores abaixo são só modelo; nada aqui é segredo real.
# Em ambiente real os segredos vêm do cofre corporativo, não de arquivo.

REDIS_URL=redis://localhost:6379/0

# Mínimo de 32 caracteres. Gere um valor aleatório: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Login mock (substitui o SSO). Todos os usuários de demonstração usam esta senha e este OTP.
MOCK_LOGIN_PASSWORD=
MOCK_OTP_CODE=

CORS_ORIGINS=["http://localhost:3000"]
# Em HTTPS use true. SameSite=strict funciona porque front e API estão no mesmo "site" (localhost).
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=strict
